<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Saylo.Desktop.ViewModels"
             x:Class="Saylo.Desktop.Views.ConversationView"
             x:DataType="vm:MainViewModel">
    <Border Classes="card" Padding="20,16" MinHeight="220">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="CONVERSACIÓN" Classes="eyebrow" />
                <TextBlock Grid.Column="1" Text="{Binding Languages.DirectionLabel}" Classes="muted" FontSize="12" />
            </Grid>
            <StackPanel Grid.Row="1" IsVisible="{Binding IsConversationEmpty}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="16,8">
                <Border Background="#EDF3FA" CornerRadius="16" Width="48" Height="48" HorizontalAlignment="Center">
                    <Path Classes="lineIcon" Data="{StaticResource MessageIcon}" Width="24" Height="24" />
                </Border>
                <TextBlock Text="Empieza con un mensaje" FontSize="19" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Escribe o prepara una frase con tu micrófono."
                           Classes="muted" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" IsVisible="{Binding HasMessages}" MaxHeight="380"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConversationMessageViewModel">
                            <Border BorderBrush="{StaticResource SayloLine}" BorderThickness="0,0,0,1" Padding="0,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding DirectionLabel}" Classes="eyebrow" />
                                    <SelectableTextBlock Text="{Binding SourceText}" TextWrapping="Wrap" />
                                    <Border Background="#F1F6FB" CornerRadius="8" Padding="12" IsVisible="{Binding HasTranslation}">
                                        <SelectableTextBlock Text="{Binding TranslatedText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock Text="{Binding PronunciationLabel}" Classes="eyebrow" />
                                    <SelectableTextBlock Text="{Binding PronunciationText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AudioStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="Texto · pronunciación aproximada o IPA · voz local"
                       Classes="muted" FontSize="11" HorizontalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
