<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Saylo.Desktop.ViewModels"
        xmlns:views="using:Saylo.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="820"
        x:Class="Saylo.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Saylo · Traductor empresarial"
        Width="1080" Height="820" MinWidth="760" MinHeight="740"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="80,*,40">
        <Border Background="{StaticResource SayloAccent}" Padding="32,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border Width="40" Height="40" Background="#3C709A" CornerRadius="10">
                    <TextBlock Text="S" FontSize="25" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                    <TextBlock Text="Saylo" FontSize="23" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Tu asistente de idiomas" FontSize="11" Foreground="#D6E4F0" />
                </StackPanel>
                <Border Grid.Column="2" Background="#335E83" CornerRadius="16" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Classes="lineIcon" Data="{StaticResource ShieldIcon}" Stroke="#DDEBF6" Width="14" Height="14" />
                        <TextBlock Text="Procesamiento local" FontSize="12" Foreground="White" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="1" Margin="32,24,32,20"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1120" MinHeight="650" Height="{Binding #WorkspaceScroll.Viewport.Height}"
              HorizontalAlignment="Stretch"
              RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                    <TextBlock Text="Tu espacio de traducción" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Prepara tus mensajes en español e inglés." Classes="muted" FontSize="13" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="ES / EN" Classes="eyebrow" VerticalAlignment="Center" />
            </Grid>
            <views:LanguageSelectionView Grid.Row="1" DataContext="{Binding Languages}" />
            <Border Grid.Row="2" Classes="card" MinHeight="190">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="20,16" ColumnDefinitions="*,Auto">
                        <TextBlock Text="CONVERSACIÓN" Classes="eyebrow" />
                        <TextBlock Grid.Column="1" Text="{Binding Languages.DirectionLabel}"
                                   Classes="muted" FontSize="12" />
                    </Grid>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="10" Margin="24,6">
                        <Border Background="#EDF3FA" CornerRadius="16" Width="52" Height="52"
                                HorizontalAlignment="Center">
                            <Path Classes="lineIcon" Data="{StaticResource MessageIcon}"
                                      Width="26" Height="26" />
                        </Border>
                        <TextBlock Text="Empieza con un mensaje" FontSize="19" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Aquí verás la traducción y cómo pronunciarla."
                                   Classes="muted" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                    <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,8,16,18">
                        <Border Classes="chip" Margin="4,0"><TextBlock Text="Texto traducido" Classes="muted" FontSize="11" /></Border>
                        <Border Classes="chip" Margin="4,0"><TextBlock Text="Pronunciación aproximada" Classes="muted" FontSize="11" /></Border>
                        <Border Classes="chip" Margin="4,0"><TextBlock Text="Voz automática" Classes="muted" FontSize="11" /></Border>
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Row="3" Classes="card" Padding="20,16">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="14">
                    <views:TextInputView DataContext="{Binding TextInput}" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel VerticalAlignment="Center" Spacing="3" Margin="0,0,12,0">
                            <TextBlock Text="Traducción aún no disponible" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#886126" />
                            <TextBlock Text="Se habilitará al completar la configuración local."
                                       Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="secondary" IsEnabled="False" Width="44"
                                AutomationProperties.Name="Grabar voz, no disponible"
                                ToolTip.Tip="La grabación de voz estará disponible en una próxima etapa.">
                            <Path Classes="lineIcon" Data="{StaticResource MicrophoneIcon}" Width="19" Height="22" />
                        </Button>
                        <Button Grid.Column="2" Classes="primary" IsEnabled="False"
                                AutomationProperties.Name="Traducir, no disponible">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="Traducir" />
                                <Path Classes="lineIcon" Data="{StaticResource ArrowIcon}" Stroke="White" Width="18" Height="18" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource SayloLine}" BorderThickness="0,1,0,0" Padding="32,0">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="Sesión temporal · sin historial guardado" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Audio local · independiente de tus llamadas" Classes="muted" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
