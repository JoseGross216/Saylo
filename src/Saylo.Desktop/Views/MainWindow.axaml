<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Saylo.Desktop.ViewModels"
        xmlns:views="using:Saylo.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="860"
        x:Class="Saylo.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Saylo · Traductor empresarial"
        Width="1080" Height="860" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Design.DataContext><vm:MainViewModel /></Design.DataContext>
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding TranslateCommand}" />
    </Window.KeyBindings>
    <Grid RowDefinitions="80,*,40">
        <Border Background="{StaticResource SayloAccent}" Padding="32,0">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <Border Width="40" Height="40" Background="#3C709A" CornerRadius="10">
                    <TextBlock Text="S" FontSize="25" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                    <TextBlock Text="Saylo" FontSize="23" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Tu asistente de idiomas" FontSize="11" Foreground="#D6E4F0" />
                </StackPanel>
                <Border Grid.Column="2" Background="#335E83" CornerRadius="16" Padding="12,7">
                    <TextBlock Text="Procesamiento local" FontSize="12" Foreground="White" />
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="32,24,32,20"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1120" HorizontalAlignment="Stretch"
                  RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
                <StackPanel Spacing="5">
                    <TextBlock Text="Tu espacio de traducción" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Prepara tus mensajes en español e inglés." Classes="muted" FontSize="13" />
                </StackPanel>
                <views:LanguageSelectionView Grid.Row="1" DataContext="{Binding Languages}" />
                <views:ConversationView Grid.Row="2" />
                <Border Grid.Row="3" Classes="card" Padding="20,16">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14">
                        <views:TextInputView DataContext="{Binding TextInput}" />
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                            <TextBlock Text="Ctrl+Enter para traducir" Classes="muted" FontSize="11"
                                       VerticalAlignment="Center" />
                            <ToggleButton Grid.Column="1" IsChecked="{Binding IsAudioPanelOpen, Mode=TwoWay}"
                                          Content="Voz" Padding="16,8" MinHeight="40" CornerRadius="8"
                                          AutomationProperties.Name="Mostrar controles de entrada por voz" />
                            <Button Grid.Column="2" Content="Cancelar" Classes="secondary"
                                    Command="{Binding TranslateCancelCommand}" IsVisible="{Binding IsTranslating}" />
                            <Button Grid.Column="3" Classes="primary" Content="Traducir"
                                    Command="{Binding TranslateCommand}" AutomationProperties.Name="Traducir mensaje" />
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Classes="muted" FontSize="12"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <views:AudioInputView Grid.Row="3" DataContext="{Binding AudioInput}"
                                              IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsAudioPanelOpen}" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource SayloLine}" BorderThickness="0,1,0,0" Padding="32,0">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Text="Sesión temporal · sin historial guardado" Classes="muted" FontSize="11" />
                <TextBlock Grid.Column="1" Text="Audio local · independiente de tus llamadas" Classes="muted" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
